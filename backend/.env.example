# Server Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://experthub.nextgoodtechnologies.in,http://localhost:5173,http://localhost:5174,http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication (JWT)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Razorpay Multi-Account Payment Gateway Configuration
# Account 1 (Primary Merchant / Default Gateway)
RAZORPAY_1_KEY_ID=rzp_test_your_key_1
RAZORPAY_1_KEY_SECRET=your_razorpay_secret_1
RAZORPAY_1_WEBHOOK_SECRET=your_razorpay_webhook_secret_1
RAZORPAY_1_ACCOUNT_NUMBER=2323230000000000

# Account 2 (Secondary Merchant / Fallback)
RAZORPAY_2_KEY_ID=rzp_test_your_key_2
RAZORPAY_2_KEY_SECRET=your_razorpay_secret_2
RAZORPAY_2_WEBHOOK_SECRET=your_razorpay_webhook_secret_2
RAZORPAY_2_ACCOUNT_NUMBER=2323230000000001

# Account 3 (Payouts / Operations / RazorpayX)
RAZORPAY_3_KEY_ID=rzp_test_your_key_3
RAZORPAY_3_KEY_SECRET=your_razorpay_secret_3
RAZORPAY_3_WEBHOOK_SECRET=your_razorpay_webhook_secret_3
RAZORPAY_3_ACCOUNT_NUMBER=2323230000000002

# Legacy Single Account Fallback (Mapped to RAZORPAY_1 if RAZORPAY_1_* not set)
RAZORPAY_KEY_ID=rzp_test_your_key_1
RAZORPAY_KEY_SECRET=your_razorpay_secret_1
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_1

# Email Services (Nodemailer / SMTP / Resend)
EMAIL_SERVICE=smtp
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
FROM_EMAIL=no-reply@experthub.nextgoodtechnologies.in
FROM_NAME=ExpertHub

